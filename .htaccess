# ======================================================================
# HUDORIAN — Apache / LiteSpeed web root configuration
# ======================================================================
# Assumes the cPanel document root (public_html) is laid out as:
#
#   public_html/
#   ├── .htaccess      <- this file
#   ├── index.html     <- published from frontend/dist by scripts/deploy.sh
#   ├── assets/        <- published from frontend/dist
#   ├── images/
#   └── backend/       <- the Laravel application
#
# Nginx hosts ignore this file entirely; configure the equivalent
# location blocks in the vhost there instead.
# ======================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # 1. FORCE HTTPS
    # ------------------------------------------------------------------
    # Must run before any other rule. The catch-all in section 6 ends the
    # rewrite pass with [L], so a redirect placed later would never match.
    <IfModule mod_ssl.c>
        RewriteCond %{HTTPS} off
        RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>

    # ------------------------------------------------------------------
    # 2. LOCK DOWN THE LARAVEL SOURCE
    # ------------------------------------------------------------------
    # The document root is the parent of backend/, so nothing under
    # backend/ is protected by backend/.htaccess. Deny it here first,
    # before any Laravel request is allowed to resolve.
    RewriteRule ^backend/(\.env|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)/ - [F,L,NC]

    # ------------------------------------------------------------------
    # 3. LARAVEL API + SANCTUM
    # ------------------------------------------------------------------
    # Hand the whole request to the Laravel front controller. REQUEST_URI is
    # left untouched (QSA, no substitution) so Laravel still resolves the
    # original /api/v1/... path from its route table.
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]
    RewriteRule ^sanctum(/.*)?$ backend/public/index.php [L,QSA]

    # ------------------------------------------------------------------
    # 4. PRESERVE AUTH HEADERS FOR SANCTUM / BEARER
    # ------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ------------------------------------------------------------------
    # 5. SERVE STATIC ASSETS
    # ------------------------------------------------------------------
    # Static build assets are served directly from disk.
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    # Anything that exists on disk is served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------
    # 6. SPA / STATIC-EXPORT FALLBACK
    # ------------------------------------------------------------------
    RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 7. PREVENT DIRECTORY LISTINGS OF THE WEB ROOT
# ----------------------------------------------------------------------
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ----------------------------------------------------------------------
# 8. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # The frontend is same-origin with the API on shared hosting, so the
    # CORS headers that backend/public/.htaccess sets for direct access
    # are intentionally not duplicated here.
</IfModule>

# ----------------------------------------------------------------------
# 9. COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 10. BROWSER CACHING
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    # Webpack chunks are content-hashed, so they can be cached forever.
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # API responses must never be cached in the browser.
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 11. BLOCK SENSITIVE FILES
# ----------------------------------------------------------------------
<FilesMatch "^\.(env|git|svn|htaccess|htpasswd|ini|log|sh|sql|yml|yaml|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
