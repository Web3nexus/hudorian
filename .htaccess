# ======================================================================
# HUDORIAN Root Live Hosting Configuration (.htaccess)
# ======================================================================
# Designed for Apache, LiteSpeed, cPanel, and VPS environments hosting
# the Laravel backend alongside the Next.js frontend.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS
    <IfModule mod_ssl.c>
        RewriteCond %{HTTPS} off
        RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>

    # 2. Block direct access to hidden files, git, and env
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|package\.(json|lock)) - [F,L,NC]
    RewriteRule ^(backend/(app|bootstrap|config|database|resources|routes|storage|tests)) - [F,L,NC]
    RewriteRule ^(node_modules|vendor) - [F,L,NC]

    # 3. Route API and Storage requests directly to Laravel backend
    RewriteRule ^(api|sanctum)(.*)$ backend/public/index.php [L,QSA]
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L,QSA]

    # 4. Forward all web traffic to the Next.js production server on port 3000
    <IfModule mod_proxy.c>
        RewriteCond %{REQUEST_URI} !^/api [NC]
        RewriteCond %{REQUEST_URI} !^/sanctum [NC]
        RewriteCond %{REQUEST_URI} !^/storage [NC]
        RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
    </IfModule>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable Directory Browsing
Options -Indexes

