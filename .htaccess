# ======================================================================
# HUDORIAN — Apache / LiteSpeed Web Root Configuration
# ======================================================================

DirectoryIndex index.html index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # 1. FORCE HTTPS
    # ------------------------------------------------------------------
    <IfModule mod_ssl.c>
        RewriteCond %{HTTPS} off
        RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>

    # ------------------------------------------------------------------
    # 2. LOCK DOWN SENSITIVE BACKEND & SOURCE FILES
    # ------------------------------------------------------------------
    RewriteRule ^backend/(\.env|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)/ - [F,L,NC]
    RewriteRule ^frontend/(src|node_modules|\.env|package\.(json|lock)|tsconfig\.json|vite\.config\.ts)/ - [F,L,NC]

    # ------------------------------------------------------------------
    # 3. LARAVEL API, SANCTUM & STORAGE
    # ------------------------------------------------------------------
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]
    RewriteRule ^sanctum(/.*)?$ backend/public/index.php [L,QSA]
    RewriteRule ^storage(/.*)?$ backend/public/index.php [L,QSA]

    # ------------------------------------------------------------------
    # 4. PRESERVE AUTH HEADERS (Sanctum / Bearer)
    # ------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ------------------------------------------------------------------
    # 5. SERVE EXISTING STATIC FILES IN WEB ROOT DIRECTLY
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------
    # 6. SERVE STATIC ASSETS FROM frontend/dist IF AVAILABLE
    # ------------------------------------------------------------------
    # Relative path match
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond frontend/dist/$1 -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # DOCUMENT_ROOT match
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # ------------------------------------------------------------------
    # 7. SPA CLIENT-SIDE ROUTING FALLBACK
    # ------------------------------------------------------------------
    # Try root index.html (published site)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond index.html -f
    RewriteRule ^ index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # Try frontend/dist/index.html (built in-repo)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond frontend/dist/index.html -f
    RewriteRule ^ frontend/dist/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
    RewriteRule ^ frontend/dist/index.html [L]

    # Ultimate fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 8. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ----------------------------------------------------------------------
# 9. COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 10. BROWSER CACHING
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    # Static assets with hash
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # API responses must never be cached
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 11. BLOCK SENSITIVE FILES
# ----------------------------------------------------------------------
<FilesMatch "^\.(env|git|svn|htaccess|htpasswd|ini|log|sh|sql|yml|yaml|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
