# ======================================================================
# HUDORIAN — repository root ignore rules
# ======================================================================
# Source of truth for the frontend is frontend/src. Everything under
# frontend/out and frontend/.next is generated by `npm run build` and is
# published to the web root by scripts/deploy.sh. None of it belongs in
# version control — committing it previously caused three copies of the
# same build to drift apart (repo root, frontend/out, frontend/.next),
# which is how a stale bundle ended up being served.

# --- Node / Next.js build output -------------------------------------
frontend/out/
frontend/.next/
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# --- Laravel ----------------------------------------------------------
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.*
backend/storage/*.key
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/logs/
backend/public/build/
backend/public/hot
backend/.phpunit.result.cache
backend/.phpunit.cache/

# --- OS / editor noise ------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Local deploy scratch --------------------------------------------
/dist/

# ======================================================================
# Published static export at the repository root
# ======================================================================
# The hosting document root is the repository root, so the built site has to
# be *published* here for the server to serve it. It is listed file by file
# on purpose: these paths are generated, must never be committed, and must be
# regenerated by `npm run build` rather than trusted from git. That is what
# stops a stale bundle — like the one that shipped pre-filled admin
# credentials — from being redeployed.
#
# To refresh them locally, publish additively (never with --delete):
#
#   rsync -a --exclude='backend/' --exclude='frontend/' \
#         --exclude='.git/' --exclude='node_modules/' \
#         frontend/out/ ./
#
/403/
/404/
/500/
/404.html
/_not-found/
/_next/
/estates/
/experiences/
/forgot-password/
/houses/
/images/
/journal/
/member/
/membership/
/privacy/
/register/
/reset-password/
/royal-archive/
/royal-family/
/royal-houses/
/securegate/
/shop/
/signin/
/stays/
/terms/
/index.html
/index.txt
/__next.*.txt
/apple-icon.png
/favicon.ico
/favicon.png
/icon.png
/logo.png
/file.svg
/globe.svg
/next.svg
/vercel.svg
/window.svg
