# ======================================================================
# HUDORIAN — Clean Separated Architecture (.gitignore)
# ======================================================================

# --- Frontend (React + Vite) -----------------------------------------
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.tsbuildinfo

# --- Backend (Laravel) -----------------------------------------------
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.*
backend/storage/*.key
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/logs/
backend/public/build/
backend/public/hot
backend/.phpunit.result.cache
backend/.phpunit.cache/

# --- OS / Editor Noise -----------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Build / Deployment Scratch --------------------------------------
/dist/
