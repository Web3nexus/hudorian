# ======================================================================
# HUDORIAN Frontend Environment Variables
# ======================================================================

# The base URL of the Laravel API v1 endpoint
# For local development:
VITE_API_URL=http://localhost:8000/api/v1

# For live production on a unified domain (via .htaccess proxy or Nginx):
# VITE_API_URL=/api/v1

# For live production with a dedicated API subdomain:
# VITE_API_URL=https://api.hudorian.com/api/v1
