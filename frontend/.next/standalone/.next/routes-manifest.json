{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/admin",
      "destination": "/securegate",
      "statusCode": 307,
      "regex": "^(?!/_next)/admin(?:/)?$"
    },
    {
      "source": "/admin/:path*",
      "destination": "/securegate/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/admin(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/houses/[slug]",
      "regex": "^/houses/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/houses/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
